{
  "name": "screenshot-to-code-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "test": "pnpm test:frontend && pnpm test:native",
    "test:frontend": "pnpm -C frontend test --runInBand",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm -C frontend lint && pnpm -C frontend build && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
