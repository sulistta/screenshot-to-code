{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled studio window can operate on projects. Preview windows have no capabilities.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "studio",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
